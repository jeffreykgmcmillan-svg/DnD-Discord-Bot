# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your-discord-bot-token-here

# Anthropic API key, used to turn raw transcripts into clean session summaries
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Whisper model size: tiny, base, small, medium, large-v3
# "small" is a good accuracy/speed balance on a free-tier CPU box
WHISPER_MODEL_SIZE=small

# Where recordings/transcripts are stored on disk
DATA_DIR=./data
